{
  "version": "2026-07-20.1",
  "no_data": { "color": "#bdbdbd", "label": "暂无数据" },
  "risk": [
    { "min": 4, "color": "#d73027", "label": "显著压力" },
    { "min": 3, "color": "#fc8d59", "label": "重点跟踪" },
    { "min": 2, "color": "#fee08b", "label": "一般关注" },
    { "min": 1, "color": "#d9ef8b", "label": "轻度异常" },
    { "min": 0, "color": "#1a9850", "label": "正常" }
